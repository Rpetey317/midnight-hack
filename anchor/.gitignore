node_modules/

# Anchor receipts: which leaf went on chain at which index, for which
# (repo, commit). Local operator state, not a build artifact — and the file the
# duplicate-suppression rule reads, so a shared copy would let one machine's
# rehearsal block another's.
.zkuat-receipts.json

# The private-state store the SDK writes next to whatever cwd you ran from.
# It holds evidence, salts, and merkle paths — the entire private side of the
# protocol. Committing one would publish exactly what this project exists to
# keep private.
midnight-level-db/
.midnight-wallet-state/

