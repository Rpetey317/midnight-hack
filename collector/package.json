{
  "name": "@zkuat/collector",
  "version": "0.1.0",
  "type": "module",
  "description": "zkuat collector — runs supply-chain checks against a project and emits a private collector report for the attestor to normalize and sign",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "bin": {
    "zkuat-collect": "src/cli/run.ts"
  },
  "scripts": {
    "postinstall": "node scripts/check-contract-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "collect": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "@zkuat/attestor": "file:../attestor"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
