// zkuat — privacy-preserving continuous software assurance.
//
// A vendor's GitHub Actions workflow produces security evidence about a build
// artifact. The locally-authorized zkuat runtime validates that document and
// inserts a blinded commitment here. It then proves locally that the committed
// evidence satisfies a buyer's published policy, disclosing only:
//
//   who (vendor, product), what (artifact digest), which policy, and pass/fail.
//
// The findings themselves — vulnerability counts and command results — are
// never written to the ledger.
//
// We hide the findings, not the vendor. A procurement record that did not say
// which vendor's which artifact is compliant would be useless to a buyer.
//
// Design docs: ../../docs/04-contract-spec.md (circuits),
// ../../docs/03-evidence-schema.md (encoding), and ../../docs/01-architecture.md
// (trust boundaries).

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Data ──────────────────────────────────────────────────────────────────────
//
// Field order is load-bearing: it determines the commitment. Reordering or
// inserting a field changes every leaf and requires a new deployment.
// Schema v3 — see ../../docs/03-evidence-schema.md.

struct Evidence {
  // ── identity ──
  // vendorId/productId are bound here, not merely passed as public inputs, so a
  // prover cannot label a record with somebody else's name.
  vendorId:                Bytes<32>;   // stringIdOf(vendor slug)
  productId:               Bytes<32>;   // stringIdOf(product slug)
  artifactDigest:          Bytes<32>;   // sha256 of the built artifact
  commitId:                Bytes<32>;   // git SHA, 20 bytes left-aligned, zero-padded

  // ── time ──
  generatedAt:             Uint<64>;    // unix seconds
  validUntil:              Uint<64>;    // unix seconds

  // ── vulnerability facts ──
  criticals:               Uint<32>;
  highs:                   Uint<32>;
  vulnDeps:                Uint<32>;    // dependencies carrying known vulns

  // ── workflow command results ──
  lintPassed:              Boolean;
  buildPassed:             Boolean;
}

// Public in ledger state so buyers can read exactly what a record means.
// `version` and `issuer` give the policy a stable, unforgeable identity: a vendor
// may choose to prove against ACME v3, but cannot silently modify ACME v3.
struct Policy {
  version:                 Uint<32>;
  issuer:                  Bytes<32>;   // stringIdOf(issuing organisation)
  maxCriticals:            Uint<32>;
  maxHighs:                Uint<32>;
  maxVulnDeps:             Uint<32>;
  requireLint:             Boolean;
  requireBuild:            Boolean;
  maxAgeSeconds:           Uint<64>;    // longest validity window the policy allows
}

// Entirely public. No private evidence goes here.
struct ComplianceRecord {
  vendorId:       Bytes<32>;
  productId:      Bytes<32>;
  artifactDigest: Bytes<32>;
  policyId:       Bytes<32>;
  policyVersion:  Uint<32>;
  provenAt:       Uint<64>;
  validUntil:     Uint<64>;
  compliant:      Boolean;
}

// ─── Ledger ────────────────────────────────────────────────────────────────────

// HistoricMerkleTree, not MerkleTree. A plain MerkleTree invalidates every
// outstanding proof on each insert — the moment a second vendor anchors, the
// first vendor's proof dies. checkRoot() here accepts any historic root, which
// is what continuous compliance depends on. Depth 16 = 65,536 attestations.
//
// The tree is also how the anchor-authorized runtime authenticates accepted
// evidence, and insert()'s leaf_hash() keeps the evidence commitment off the
// transcript — so nobody can build a leaf→artifact correlation table.
export ledger attestations: HistoricMerkleTree<16, Bytes<32>>;

// Buyer-published policies, readable by anyone.
export ledger policies:     Map<Bytes<32>, Policy>;

// Nullifiers. Already-public values, so a Set is right; privacy comes from the
// nullifier being unguessable, not from hiding the set.
export ledger claimed:      Set<Bytes<32>>;

// Current compliance status, keyed by recordKeyOf(artifactDigest, policyId) —
// exactly the buyer's query. A later proof for the same pair replaces the entry,
// which is the desired continuous-compliance behaviour.
//
// Note this Map iterates in the generated TypeScript (its value is a plain
// struct), so the buyer dashboard needs no separate index. A Map whose value is
// itself a ledger ADT — Map<_, Counter> — does not iterate. That difference is
// why there is no compliantCount here: `records` subsumes it and gives an exact
// count, whereas a counter would double-count re-proofs of the same artifact.
export ledger records:      Map<Bytes<32>, ComplianceRecord>;

// Append-only timeline for the buyer's history view. Also iterates.
export ledger history:      List<ComplianceRecord>;

// The anchor operator's identity, fixed at deployment. `sealed` gives
// compiler-enforced immutability, so no runtime reassignment check is needed.
export sealed ledger anchor: Bytes<32>;

// ─── Witnesses ─────────────────────────────────────────────────────────────────

// The anchor's secret. The runtime derives it from its sponsor wallet seed with
// a domain-separated KDF. Only attest/registerPolicy reach for it.
witness localSecret(): Bytes<32>;

// The vendor's private evidence, its salt, and its Merkle path. None of these
// ever leave the vendor's machine.
witness getEvidence(): Evidence;
witness getSalt(): Bytes<32>;
witness getPath(): MerkleTreePath<16, Bytes<32>>;

// ─── Shared derivations ────────────────────────────────────────────────────────
//
// These are `pure`, so the compiler emits them into the generated `pureCircuits`
// object and they are callable from TypeScript with no context and no
// transaction. The runtime and tests call these rather than reimplementing the
// encoding — which makes the schema drift that
// ../../docs/03-evidence-schema.md flags as the project's highest risk
// structurally impossible rather than merely discouraged.
//
// proveCompliance below calls leafOf/nullifierOf rather than inlining the
// expressions. That identity is the whole point: what TypeScript computes is,
// byte for byte, what the circuit checks.

export pure circuit leafOf(ev: Evidence, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Evidence>(ev, salt);
}

export pure circuit nullifierOf(leaf: Bytes<32>, policyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zkuat:proof:nul:"), leaf, policyId
  ]);
}

// The buyer's lookup key. Pure, so the buyer UI computes it off-chain and reads
// `records` directly.
export pure circuit recordKeyOf(artifactDigest: Bytes<32>, policyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zkuat:record:key:"), artifactDigest, policyId
  ]);
}

// Any identifier that starts life as a string: policy ids, vendor ids, product
// ids, issuer names. Bytes<N> is fixed-width in Compact, so the
// padding has to be pinned somewhere — it is pinned at 64 bytes, zero-padded
// right, and the TypeScript encoder throws rather than truncating.
export pure circuit stringIdOf(s: Bytes<64>): Bytes<32> {
  return persistentHash<Bytes<64>>(s);
}

// Identity is derived from a witness secret, NOT from ownPublicKey(). The latter
// is prover-supplied circuit context — any caller can put any value there, so it
// is bypassable for authorization. Its only safe use is routing tokens to a caller.
export pure circuit anchorIdOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "zkuat:anchor:pk:"), sk
  ]);
}

// ─── Setup ─────────────────────────────────────────────────────────────────────

constructor() {
  // Whoever deploys becomes the anchor, permanently.
  anchor = disclose(anchorIdOf(localSecret()));
}

circuit requireAnchor(): [] {
  assert(disclose(anchorIdOf(localSecret()) == anchor), "not anchor");
}

// ─── Circuits ──────────────────────────────────────────────────────────────────

// Anchor-only. `leaf` needs disclose(): circuit arguments are private by default
// and the compiler's disclosure analysis treats any ledger operation as a
// potential disclosure of its argument. Note this is the compiler being
// conservative about the *annotation*, not proof that the leaf reaches the
// transcript in the clear — insert() applies leaf_hash() internally.
//
// Use insert(), never insertHash(): insertHash publishes the hash you hand it.
// Correspondingly proveCompliance uses merkleTreePathRoot (which hashes the
// leaf), not merkleTreePathRootNoLeafHash.
export circuit attest(leaf: Bytes<32>): [] {
  requireAnchor();
  attestations.insert(disclose(leaf));
}

// Anchor-only. Buyers publish thresholds through the anchor so that policy
// identity is stable: the same policyId always means the same requirements at a
// given version.
export circuit registerPolicy(policyId: Bytes<32>, policy: Policy): [] {
  requireAnchor();
  policies.insert(disclose(policyId), disclose(policy));
}

// Called by the vendor, on their own machine.
//
// Public: vendor, product, artifact digest, policy, evidence dates, verdict.
// Private: every vulnerability count, workflow result, commit, salt, leaf, and
// path sibling.
export circuit proveCompliance(
  vendorId:       Bytes<32>,
  productId:      Bytes<32>,
  artifactDigest: Bytes<32>,
  policyId:       Bytes<32>
): Boolean {
  const ev   = getEvidence();
  const salt = getSalt();
  const leaf = leafOf(ev, salt);

  // 1. Authenticated? Bind the witness-supplied path to OUR computed commitment,
  //    then bind that to the tree. Without the first assert a prover could supply
  //    a path for somebody else's anchored leaf and prove against it.
  const path = getPath();
  assert(disclose(path.leaf == leaf), "path/leaf mismatch");
  const digest = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(attestations.checkRoot(disclose(digest)), "not attested");

  // 2. About THIS vendor's THIS product's THIS artifact?
  //
  //    The artifact binding is what stops the proof meaning "*some* attested
  //    artifact passes". The vendor and product bindings are what stop a prover
  //    writing a record under somebody else's name — without them, a buyer
  //    filtering `records` by vendor would see forged entries. All three compare
  //    a private evidence field against a public input, so only the boolean
  //    leaks, and for an honest prover it is always true.
  assert(disclose(ev.vendorId       == vendorId),       "vendor mismatch");
  assert(disclose(ev.productId      == productId),      "product mismatch");
  assert(disclose(ev.artifactDigest == artifactDigest), "artifact mismatch");

  // 3. Not replayed? The nullifier is over (leaf, policyId), so the same evidence
  //    cannot be proven twice against the same policy — but fresh evidence yields
  //    a new leaf and a new proof, which is exactly what continuous compliance
  //    needs. The same evidence against a *different* policy is also permitted.
  const nul = disclose(nullifierOf(leaf, policyId));
  assert(!claimed.member(nul), "already proven");
  claimed.insert(nul);

  const p = policies.lookup(disclose(policyId));

  // 4. Is the validity window longer than the policy allows?
  //    This is freshness enforcement that needs no block-time primitive: it
  //    bounds validUntil relative to generatedAt, both of which are committed.
  //    It does NOT check the evidence against wall-clock now — the record carries
  //    validUntil and the reader judges expiry.
  assert(disclose(ev.validUntil <= ev.generatedAt + p.maxAgeSeconds),
         "validity window exceeds policy");

  // 5. The predicate.
  //
  //    disclose() wraps the *conjunction*, never the operands. Writing
  //    disclose(ev.criticals) would publish the finding count and defeat the
  //    entire protocol — and disclosing each requirement separately would leak
  //    which specific control failed. The buyer's per-requirement checklist
  //    renders from `ok` alone: for a passing record every line is ✓ by
  //    definition. Do not add per-requirement disclosure without deciding that
  //    leaking the failure reason is acceptable.
  const ok = disclose(
    ev.criticals <= p.maxCriticals &&
    ev.highs     <= p.maxHighs     &&
    ev.vulnDeps  <= p.maxVulnDeps  &&
    (!p.requireLint  || ev.lintPassed) &&
    (!p.requireBuild || ev.buildPassed)
  );

  // 6. The public, time-bound record. Written whether or not the predicate passed,
  //    carrying the verdict — so a buyer distinguishes NOT COMPLIANT from
  //    NO CURRENT PROOF, and the negative case is demonstrable on-chain.
  const rec = ComplianceRecord {
    vendorId:       disclose(vendorId),
    productId:      disclose(productId),
    artifactDigest: disclose(artifactDigest),
    policyId:       disclose(policyId),
    policyVersion:  p.version,
    provenAt:       disclose(ev.generatedAt),
    validUntil:     disclose(ev.validUntil),
    compliant:      ok
  };

  records.insert(recordKeyOf(disclose(artifactDigest), disclose(policyId)), rec);
  history.pushFront(rec);

  return ok;
}
