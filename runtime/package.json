{
  "name": "@zkuat/runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Local zkuat sponsor runtime: GitHub evidence, proving, anchoring, submission, and verification",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "bin": {
    "zkuat-runtime": "src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts start",
    "deploy": "tsx src/cli.ts deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scure/bip39": "2.0.1",
    "@zkuat/contract": "file:../contract"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
